{
  "name": "logloop",
  "version": "0.5.0",
  "description": "Continuous loop of personal logs in the terminal",
  "main": "bin/index.js",
  "bin": {
    "logloop": "bin/index.js"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "jest --coverage",
    "dev": "node bin/index.js",
    "site": "open site/index.html",
    "preview": "open site/index.html && npm run dev",
    "dashboard:backend": "npm run start:dev --prefix dashboard/backend",
    "dashboard:frontend": "npm run dev --prefix dashboard/frontend",
    "release": "standard-version && git push origin main --follow-tags && npm publish",
    "release:minor": "standard-version --release-as minor && git push origin main --follow-tags && npm publish",
    "release:dry": "standard-version --dry-run"
  },
  "keywords": [
    "cli",
    "developer-tools",
    "git",
    "devlog",
    "productivity",
    "documentation",
    "engineering"
  ],
  "author": "chavito",
  "license": "MIT",
  "dependencies": {
    "fuse.js": "^7.3.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "standard-version": "^9.5.0"
  }
}
